<?xml version="1.0"?>
<mujoco xmlns:xacro="http://www.ros.org/wiki/xacro" model="Multi-Drone Scene">
  
  <xacro:arg name="quad_name_1" default="quadrotor1"/>
  <xacro:arg name="init_x_1" default="0.0"/>
  <xacro:arg name="init_y_1" default="0.0"/>
  <xacro:arg name="init_z_1" default="0.02"/>
  <xacro:arg name="init_roll_1"  default="0.0"/>
  <xacro:arg name="init_pitch_1" default="0.0"/>
  <xacro:arg name="init_yaw_1"   default="0.0"/>

  <xacro:arg name="quad_name_2" default="quadrotor2"/>
  <xacro:arg name="init_x_2" default="0.3"/>
  <xacro:arg name="init_y_2" default="0.3"/>
  <xacro:arg name="init_z_2" default="0.02"/>
  <xacro:arg name="init_roll_2"  default="0.0"/>
  <xacro:arg name="init_pitch_2" default="0.0"/>
  <xacro:arg name="init_yaw_2"   default="0.0"/>


  <xacro:include filename="quadrotor_acro_macro.xml.xacro" />


  <compiler angle="radian"/>

  <option timestep="0.003" gravity="0 0 -9.81" density="1.225" viscosity="1.8e-05" integrator="RK4">
    <flag contact="disable"/>
  </option>



  <extension>
    <plugin plugin="MujocoRosUtils::WrenchToActuators"/>
    <plugin plugin="MujocoRosUtils::OdometryPublisher"/>
    <plugin plugin="MujocoRosUtils::SensorPublisher"/>
    <plugin plugin="MujocoRosUtils::ImuPublisher"/>
    <plugin plugin="MujocoRosUtils::AcroMode"/>
    <plugin plugin="MujocoRosUtils::LowLevelMode"/>
  </extension>

  <asset>
    <material name="mat_red"   rgba="0.8 0.1 0.1 1" reflectance="0.01" shininess="0.01" specular="0.0" />
    <material name="mat_green" rgba="0.1 0.8 0.1 1" reflectance="0.01" shininess="0.01" specular="0.0" />
    <material name="mat_blue"  rgba="0.1 0.1 0.8 1" reflectance="0.01" shininess="0.01" specular="0.0" />

    <texture type="skybox" builtin="flat" rgb1="0 0 0" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>


  </asset>

  <worldbody>
    <light pos="1 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>


    <geom name="box_red" type="box" pos="2 1 0.1" size="0.2 0.2 0.1" material="mat_red" />
    <geom name="box_green" type="box" pos="4 -1 0.1" size="0.2 0.2 0.1" material="mat_green" />
    <geom name="box_blue" type="box" pos="6 1 0.1" size="0.2 0.2 0.1" material="mat_blue" />

    <xacro:quadrotor_body prefix="$(arg quad_name_1)" pos="$(arg init_x_1) $(arg init_y_1) $(arg init_z_1)" euler="$(arg init_roll_1) $(arg init_pitch_1) $(arg init_yaw_1)" />
    <xacro:quadrotor_body prefix="$(arg quad_name_2)" pos="$(arg init_x_2) $(arg init_y_2) $(arg init_z_2)" euler="$(arg init_roll_2) $(arg init_pitch_2) $(arg init_yaw_2)" />


    <body name="payload" pos="0.3 0.3 1.0">
      <joint type="free" damping="0.01"/>
      <geom type="sphere" size="0.03" rgba="0 0 1 0.8" mass="0.1128"/>
      <site name="payload_connection_site" pos="0.0 0.0 0.03"/>
    </body>

    <geom name="origin_x" type="cylinder" fromto="0 0 0.01 0.5 0 0.01" size="0.01" rgba="1 0 0 0.1" contype="0" conaffinity="0" group="1"/>
    <geom name="origin_y" type="cylinder" fromto="0 0 0.01 0 0.5 0.01" size="0.01" rgba="0 1 0 0.1" contype="0" conaffinity="0" group="1"/>
    <geom name="origin_z" type="cylinder" fromto="0 0 0.01 0 0 0.51" size="0.01" rgba="0 0 1 0.1" contype="0" conaffinity="0" group="1"/>

    <camera name="camera_pov" pos="-2.427 1.392 1.622" xyaxes="-0.216 -0.976 -0.000 0.227 -0.050 0.973"/>

  </worldbody>

  <actuator>
    <xacro:quadrotor_actuators prefix="$(arg quad_name_1)" />
    <xacro:quadrotor_actuators prefix="$(arg quad_name_2)" />
  </actuator>

  <sensor>
    <xacro:quadrotor_physical_sensors prefix="$(arg quad_name_1)" />
    <xacro:quadrotor_sensor_plugins prefix="$(arg quad_name_1)" />
    <xacro:quadrotor_physical_sensors prefix="$(arg quad_name_2)" />
    <xacro:quadrotor_sensor_plugins prefix="$(arg quad_name_2)" />

    <plugin name="payload_odom" plugin="MujocoRosUtils::OdometryPublisher" objtype="xbody" objname="payload">
      <config key="publish_rate" value="240"/>
      <config key="topic_prefix" value="$(arg quad_name_1)"/>
    </plugin>

  </sensor>
  <tendon>
    <spatial name="rope1" limited="true" range="0 0.8" width=".0005">
      <site site="$(arg quad_name_1)_payload_site"/>
      <site site="payload_connection_site"/>
    </spatial>

    <spatial name="rope2" limited="true" range="0 0.8" width=".0005">
      <site site="$(arg quad_name_2)_payload_site"/>
      <site site="payload_connection_site"/>
    </spatial>
      
  </tendon>
</mujoco>
